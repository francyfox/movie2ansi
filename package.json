{
	"name": "movie2ansi",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --hot ./src/index.html",
		"typecheck": "bun check",
		"lint": "bunx --bun @biomejs/biome lint --write",
		"format": "bunx --bun @biomejs/biome format --write",
		"lint:toml": "taplo lint encode.toml",
		"schema": "bun ./src/schema.ts",
		"encode": "bun ./src/encode.ts -c encode.toml",
		"play": "bun ./src/play.ts",
		"build:player": "bun ./scripts/build-player.ts",
		"build:bin": "bun ./scripts/build-binaries.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@taplo/cli": "^0.7.0",
		"@types/bun": "latest",
		"@unocss/reset": "^66.12.0"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"imports": {
		"#libs/*": "./src/libs/*.ts",
		"#modules": "./src/modules/index.ts",
		"#modules/*": "./src/modules/*/index.ts"
	},
	"dependencies": {
		"@ffmpeg/core": "0.12.10",
		"@fontsource/instrument-serif": "^5.3.0",
		"typebox": "^1.4.7"
	}
}
